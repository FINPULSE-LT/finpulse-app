NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# AI Voice & Text Processing (Opcional para NLP avanzado)
GEMINI_API_KEY=your-gemini-api-key
